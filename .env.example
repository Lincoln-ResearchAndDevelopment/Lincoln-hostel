APP_NAME=LincHostel
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ========================================
# DATABASE - MySQL (recommended for Plask)
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linchostel
DB_USERNAME=linchostel_user
DB_PASSWORD=your-secure-password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false

# Optional: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=linchostel
# DB_USERNAME=linchostel_user
# DB_PASSWORD=your-secure-password

# ========================================
# MAIL - SMTP Configuration
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lincoln.edu.ng
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# SESSION
# ========================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_CONNECTION=null
SESSION_STORE=null

# ========================================
# CACHE & QUEUE
# ========================================
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
# For production with Redis:
# QUEUE_CONNECTION=redis

# ========================================
# REDIS (optional - for sessions, cache, queue)
# ========================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1

# ========================================
# LOGGING
# ========================================
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=null

# ========================================
# FILESYSTEM
# ========================================
FILESYSTEM_DISK=local

# Optional: S3 / Cloud Storage
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ========================================
# SANCTUM (API Auth)
# ========================================
SANCTUM_STATEFUL_DOMAINS=your-domain.com
SANCTUM_TOKEN_PREFIX=
SESSION_DOMAIN=.your-domain.com

# ========================================
# CORS
# ========================================
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ========================================
# BROADCASTING (optional)
# ========================================
BROADCAST_DRIVER=log

# ========================================
# VITE (Frontend Build)
# ========================================
VITE_APP_NAME="${APP_NAME}"
ASSET_URL=
